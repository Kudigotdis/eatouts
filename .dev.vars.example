# ------------------------------------------------------------------
# Copy this file to ".dev.vars" for local `wrangler pages dev` work.
# ".dev.vars" is gitignored and must NEVER be committed.
# ------------------------------------------------------------------

# Turns off the production guard so the dev-login shortcut works.
ENV=development

# Signing key for future sessions (not used by dev-login yet).
SESSION_SECRET=change-me-to-a-long-random-string

# Which emails may use the passwordless dev-login (comma separated).
# Leave empty to allow any email in development (first-run only).
DEV_LOGIN_EMAILS=you@example.com

# Which emails are treated as EatOuts admins (comma separated).
ADMIN_EMAILS=you@example.com

# --- Supabase Storage (media) -----------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key. SERVER-SIDE ONLY - never expose to the browser.
SUPABASE_KEY=
# Storage bucket name you created in Supabase.
SUPABASE_BUCKET=eatouts-media
# Optional: override the public URL prefix for uploaded files.
# Defaults to <SUPABASE_URL>/storage/v1/object/public/<bucket>
PUBLIC_BASE=