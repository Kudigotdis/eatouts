{
  "name": "eatouts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "merge":   "python scripts/build_restaurant_directory.py",
    "build":   "npm run merge && node copy-static.mjs",
    "stage":   "node copy-static.mjs",
    "deploy":  "npm run build && wrangler pages deploy dist",
    "preview": "npm run build && wrangler pages dev dist",
    "validate": "python scripts/validate_submission.py",
    "test":     "node tests/run-all.js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}